          "command": "edgefab.refresh",
          "when": "false"
        },
        {
          "command": "edgefab.reveal",
          "when": "false"
        },
        {
          "command": "edgefab.openPreview",
          "when": "false"
        },
        {
          "command": "edgefab.delete",
          "when": "false"
        },
        {
          "command": "edgefab.view",
          "when": "false"
        },
        {
          "command": "edgefab.addToProject",
          "when": "false"
        },
        {
          "command": "edgefab.paintGlow",
          "when": "false"
        },
        {
          "command": "edgefab.glowStrength",
          "when": "false"
        },
        {
          "command": "edgefab.glowOff",
          "when": "false"
        },
        {
          "command": "edgefab.make3d",
          "when": "false"
        },
        {
          "command": "edgefab.redraw",
          "when": "false"
        },
        {
          "command": "edgefab.openPicture",
          "when": "false"
        },
        {
          "command": "edgefab.setSize",
          "when": "false"
        },
        {
          "command": "edgefab.addToLibrary",
          "when": "false"
        },
        {
          "command": "edgefab.library.view",
          "when": "false"
        },
        {
          "command": "edgefab.library.addToProject",
          "when": "false"
        },
        {
          "command": "edgefab.library.edit",
          "when": "false"
        },
        {
          "command": "edgefab.library.reveal",
          "when": "false"
        },
        {
          "command": "edgefab.library.makeProp",
          "when": "false"
        },
        {
          "command": "edgefab.library.refresh",
          "when": "false"
        },
        {
          "command": "edgefab.makeProp",
          "when": "false"
        },
        {
          "command": "edgefab.rename",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "edgefab.makeProp",
          "when": "resourceExtname =~ /^.(glb|gltf)$/i",
          "group": "navigation@90"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "edgefab.mcp",
        "label": "EDGEfab"
      }
    ],
    "configuration": {
      "title": "EDGEfab",
      "properties": {
        "edgefab.collision": {
          "type": "string",
          "enum": [
            "physical",
            "box",
            "none"
          ],
          "default": "physical",
          "enumDescriptions": [
            "One physical mesh component, its box in the mesh's physics data (what EDGEbuilder asked for: a baked entity with it is solid)",
            "A mesh component and a collider component with a box, as the game's own props have",
            "No collision: the prop only draws, and V walks through it"
          ],
          "markdownDescription": "How a prop added to a project is solid. Both kinds of box fit the prop's size, and both stop V in the game (tested 2026-11-09)."
        },
        "edgefab.generateInParts": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Generate models in parts, each with its own material, so EDGEmat can give one part a new look. Costs Tripo about 20 to 30 credits more, and Tripo gives no real size for them: EDGEfab asks how tall the object is."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node ../../tools/release/notes.mjs --extension && node esbuild.mjs && node ../../tools/release/notices.mjs --extension",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@edgemodders/edgemat-core": "~0.3.2",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/vscode": "1.70.0",
    "esbuild": "^0.28.2",
    "gl-matrix": "3.4.4",
    "jpeg-js": "^0.4.4",
    "meshoptimizer": "1.3.0",
    "mikktspace": "1.1.1",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.3"
  }
}
