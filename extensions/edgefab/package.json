        "category": "EDGEfab",
        "icon": "$(sync)"
      },
      {
        "command": "edgefab.rename",
        "title": "Rename...",
        "category": "EDGEfab"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "edgefab.importGlb",
          "when": "view == edgefab.desk",
          "group": "navigation@1"
        },
        {
          "command": "edgefab.generate",
          "when": "view == edgefab.desk",
          "group": "navigation@2"
        },
        {
          "command": "edgefab.refresh",
          "when": "view == edgefab.desk",
          "group": "navigation@3"
        },
        {
          "command": "edgefab.refreshFromLibrary",
          "when": "view == edgefab.library && edgefab.hasLibrary",
          "group": "navigation@1"
        },
        {
          "command": "edgefab.library.refresh",
          "when": "view == edgefab.library",
          "group": "navigation@2"
        },
        {
          "command": "edgefab.library.setRoot",
          "when": "view == edgefab.library",
          "group": "1@1"
        },
        {
          "command": "edgefab.library.setModder",
          "when": "view == edgefab.library",
          "group": "1@2"
        }
      ],
      "view/item/context": [
        {
          "command": "edgefab.view",
          "when": "view == edgefab.desk && viewItem =~ /^desk/",
          "group": "inline"
        },
        {
          "command": "edgefab.addToProject",
          "when": "view == edgefab.desk && viewItem =~ /^desk/",
          "group": "inline"
        },
        {
          "command": "edgefab.addToProject",
          "when": "view == edgefab.desk && viewItem =~ /^desk/",
          "group": "1@0"
        },
        {
          "command": "edgefab.view",
          "when": "view == edgefab.desk && viewItem =~ /^desk/",
          "group": "1@0"
        },
        {
          "command": "edgefab.openPreview",
          "when": "view == edgefab.desk && viewItem =~ /^desk\\.preview/",
          "group": "1@1"
        },
        {
          "command": "edgefab.reveal",
          "when": "view == edgefab.desk && viewItem =~ /^(desk|picture)/",
          "group": "1@2"
        },
        {
          "command": "edgefab.paintGlow",
          "when": "view == edgefab.desk && viewItem =~ /^desk/",
          "group": "1@3"
        },
        {
          "command": "edgefab.glowStrength",
          "when": "view == edgefab.desk && viewItem =~ /\\.glow/",
          "group": "1@4"
        },
        {
          "command": "edgefab.glowOff",
          "when": "view == edgefab.desk && viewItem =~ /\\.glow/",
          "group": "1@5"
        },
        {
          "command": "edgefab.delete",
          "when": "view == edgefab.desk && viewItem =~ /^(desk|picture)/",
          "group": "2@1"
        },
        {
          "command": "edgefab.make3d",
          "when": "view == edgefab.desk && viewItem == picture",
          "group": "inline"
        },
        {
          "command": "edgefab.openPicture",
          "when": "view == edgefab.desk && viewItem == picture",
          "group": "inline"
        },
        {
          "command": "edgefab.make3d",
          "when": "view == edgefab.desk && (viewItem == picture || viewItem =~ /\\.views/)",
          "group": "0@1"
        },
        {
          "command": "edgefab.redraw",
          "when": "view == edgefab.desk && (viewItem == picture || viewItem =~ /\\.views/)",
          "group": "0@2"
        },
        {
          "command": "edgefab.openPicture",
          "when": "view == edgefab.desk && (viewItem == picture || viewItem =~ /\\.views/)",
          "group": "0@3"
        },
        {
          "command": "edgefab.setSize",
          "when": "view == edgefab.desk && viewItem =~ /^desk/",
          "group": "1@2"
        },
        {
          "command": "edgefab.addToLibrary",
          "when": "view == edgefab.desk && viewItem =~ /^desk/",
          "group": "1@0"
        },
        {
          "command": "edgefab.library.view",
          "when": "view == edgefab.library && viewItem == libprop",
          "group": "inline"
        },
        {
          "command": "edgefab.library.addToProject",
          "when": "view == edgefab.library && viewItem == libprop",
          "group": "inline"
        },
        {
          "command": "edgefab.library.addToProject",
          "when": "view == edgefab.library && viewItem == libprop",
          "group": "1@0"
        },
        {
          "command": "edgefab.library.view",
          "when": "view == edgefab.library && viewItem == libprop",
          "group": "1@1"
        },
        {
          "command": "edgefab.library.edit",
          "when": "view == edgefab.library && viewItem == libprop",
          "group": "1@2"
        },
        {
          "command": "edgefab.library.makeProp",
          "when": "view == edgefab.library && viewItem == libmodel.glb",
          "group": "inline"
        },
        {
          "command": "edgefab.library.makeProp",
          "when": "view == edgefab.library && viewItem == libmodel.glb",
          "group": "1@0"
        },
        {
          "command": "edgefab.library.reveal",
          "when": "view == edgefab.library && viewItem =~ /^lib/",
          "group": "2@0"
        },
        {
          "command": "edgefab.rename",
          "when": "view == edgefab.desk && viewItem =~ /^(desk|picture)/",
          "group": "2@0"
        }
