{
  "name": "edgefab",
  "displayName": "EDGEfab",
  "description": "The EDGE asset maker for Cyberpunk 2077: turn a textured 3D model, your own or made by Tripo from your words, into a prop the game can use.",
  "publisher": "edgemodders",
  "version": "0.1.0",
  "license": "MIT",
  "preview": true,
  "galleryBanner": {
    "color": "#08090d",
    "theme": "dark"
  },
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Edgemodders/EDGEfab.git",
    "directory": "extensions/edgefab"
  },
  "homepage": "https://edgemodders.github.io/EDGEfab/",
  "bugs": {
    "url": "https://github.com/Edgemodders/EDGEfab/issues"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cyberpunk",
    "cyberpunk2077",
    "modding",
    "3d",
    "glb",
    "tripo",
    "wolvenkit"
  ],
  "engines": {
    "vscode": "^1.70.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:edgefab.desk",
    "onCommand:edgefab.importGlb",
    "onCommand:edgefab.generate",
    "onCommand:edgefab.setTripoKey",
    "onCommand:edgefab.clearTripoKey",
    "onCommand:edgefab.tripoPlan",
    "onCommand:edgefab.connectAssistant",
    "onCommand:edgefab.showLog",
    "onCommand:edgefab.setOpenAIKey",
    "onCommand:edgefab.clearOpenAIKey",
    "onView:edgefab.library",
    "onCommand:edgefab.library.setRoot",
    "onCommand:edgefab.library.setModder",
    "onCommand:edgefab.refreshFromLibrary",
    "onCommand:edgefab.makeProp"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "edgefab",
          "title": "EDGEfab",
          "icon": "images/activity.svg"
        }
      ]
    },
    "views": {
      "edgefab": [
        {
          "id": "edgefab.desk",
          "name": "Desk"
        },
        {
          "id": "edgefab.library",
          "name": "Library"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "edgefab.desk",
        "contents": "Make a prop for Cyberpunk 2077 from a textured 3D model: one of your own (GLB), or one Tripo makes from your words with your own Tripo key.\n[Import a GLB...](command:edgefab.importGlb)\n[Generate from Words...](command:edgefab.generate)\nEDGEfab gets it ready for the game: real size, standing on its base, three levels of detail, and its textures taken out for its materials. It waits here on your Desk, kept between sessions, until you put it in a project or your Library."
      },
      {
        "view": "edgefab.library",
        "when": "!edgefab.hasLibrary",
        "contents": "The EDGE Library: one folder every EDGE tool shares, outside any project, for props and other things you reuse across mods. Its folders are yours to name. Optional: the Desk and Add to Project work without it.\n[Set Up the Library...](command:edgefab.library.setRoot)"
      }
    ],
    "commands": [
      {
        "command": "edgefab.importGlb",
        "title": "Import a GLB...",
        "category": "EDGEfab",
        "icon": "$(folder-opened)"
      },
      {
        "command": "edgefab.generate",
        "title": "Generate from Words...",
        "category": "EDGEfab",
        "icon": "$(sparkle)"
      },
      {
        "command": "edgefab.make3d",
        "title": "Make 3D...",
        "category": "EDGEfab",
        "icon": "$(wand)"
      },
      {
        "command": "edgefab.redraw",
        "title": "Change the Words...",
        "category": "EDGEfab",
        "icon": "$(edit)"
      },
      {
        "command": "edgefab.openPicture",
        "title": "Open the Picture",
        "category": "EDGEfab",
        "icon": "$(file-media)"
      },
      {
        "command": "edgefab.setSize",
        "title": "Set Size...",
        "category": "EDGEfab",
        "icon": "$(symbol-ruler)"
      },
      {
        "command": "edgefab.setTripoKey",
        "title": "Set Tripo Key",
        "category": "EDGEfab"
      },
      {
        "command": "edgefab.clearTripoKey",
        "title": "Clear Tripo Key",
        "category": "EDGEfab"
      },
      {
        "command": "edgefab.tripoPlan",
        "title": "Set Tripo Plan (Paid or Free)",
        "category": "EDGEfab"
      },
      {
        "command": "edgefab.setOpenAIKey",
        "title": "Set OpenAI Key",
        "category": "EDGEfab"
      },
      {
        "command": "edgefab.clearOpenAIKey",
        "title": "Clear OpenAI Key",
        "category": "EDGEfab"
      },
      {
        "command": "edgefab.connectAssistant",
        "title": "Connect an Assistant (MCP)...",
        "category": "EDGEfab"
      },
      {
        "command": "edgefab.showLog",
        "title": "Show Log",
        "category": "EDGEfab"
      },
      {
        "command": "edgefab.refresh",
        "title": "Refresh",
        "category": "EDGEfab",
        "icon": "$(refresh)"
      },
      {
        "command": "edgefab.reveal",
        "title": "Reveal in File Explorer",
        "category": "EDGEfab"
      },
      {
        "command": "edgefab.view",
        "title": "Open in 3D",
        "category": "EDGEfab",
        "icon": "$(eye)"
      },
      {
        "command": "edgefab.addToProject",
        "title": "Add to Project",
        "category": "EDGEfab",
        "icon": "$(new-file)"
      },
      {
        "command": "edgefab.paintGlow",
        "title": "Make the Painted Lights Glow...",
        "category": "EDGEfab",
        "icon": "$(lightbulb)"
      },
      {
        "command": "edgefab.glowStrength",
        "title": "Glow Strength...",
        "category": "EDGEfab"
      },
      {
        "command": "edgefab.glowOff",
        "title": "Stop the Glow",
        "category": "EDGEfab"
      },
      {
        "command": "edgefab.openPreview",
        "title": "Open Tripo's Preview",
        "category": "EDGEfab"
      },
      {
        "command": "edgefab.delete",
        "title": "Delete",
        "category": "EDGEfab"
      },
      {
        "command": "edgefab.addToLibrary",
        "title": "Add to Library...",
        "category": "EDGEfab",
        "icon": "$(library)"
      },
      {
        "command": "edgefab.library.setRoot",
        "title": "Set the Library Folder...",
        "category": "EDGEfab",
        "icon": "$(gear)"
      },
      {
        "command": "edgefab.library.setModder",
        "title": "Set Your Folder in Game Paths...",
        "category": "EDGEfab"
      },
      {
        "command": "edgefab.library.refresh",
        "title": "Refresh the Library",
        "category": "EDGEfab",
        "icon": "$(refresh)"
      },
      {
        "command": "edgefab.library.view",
        "title": "Open in 3D",
        "category": "EDGEfab",
        "icon": "$(eye)"
      },
      {
        "command": "edgefab.library.addToProject",
        "title": "Add to Project",
        "category": "EDGEfab",
        "icon": "$(add)"
      },
      {
        "command": "edgefab.library.edit",
        "title": "Edit on the Desk",
        "category": "EDGEfab"
      },
      {
        "command": "edgefab.library.reveal",
        "title": "Reveal in File Explorer",
        "category": "EDGEfab"
      },
      {
        "command": "edgefab.library.makeProp",
        "title": "Make a Prop",
        "category": "EDGEfab",
        "icon": "$(wand)"
      },
      {
        "command": "edgefab.makeProp",
        "title": "Make a Prop (EDGEfab)",
